[submodule "upstream/zlib"]
	path = upstream/zlib
	url = https://github.com/madler/zlib.git
[submodule "upstream/lua"]
	path = upstream/lua
	url = https://github.com/lua/lua.git
[submodule "upstream/cjson"]
	path = upstream/cjson
	url = https://github.com/DaveGamble/cJSON.git
