	path = upstream/inih
	url = https://github.com/benhoyt/inih.git
[submodule "upstream/linenoise"]
	path = upstream/linenoise
	url = https://github.com/antirez/linenoise.git
[submodule "upstream/libuv"]
	path = upstream/libuv
	url = https://github.com/libuv/libuv.git
[submodule "upstream/node"]
	path = upstream/node
	url = https://github.com/nodejs/node.git
